# Copy to .env and fill in your own credentials. .env is git-ignored.
# Never commit connection URIs or passwords.
#
# A platform is benchmarked only if its *_URI is set; the others are reported
# as "not configured" instead of silently skipped.

# --- CognoDB Cloud (subject of the benchmark) ---
COGNODB_URI=bolt+s://<instance-id>.databases.cognodb.com
COGNODB_USERNAME=cognodb
COGNODB_PASSWORD=
COGNODB_DATABASE=neo4j
COGNODB_SPECS=free c0, burstable 0.5 vCPU / 256 MB RAM / 1 GB disk

# --- Neo4j (AuraDB Free or resource-capped Community in Docker) ---
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
NEO4J_SPECS=

# --- Memgraph (free tier or resource-capped Docker) ---
MEMGRAPH_URI=
MEMGRAPH_USERNAME=
MEMGRAPH_PASSWORD=
MEMGRAPH_DATABASE=memgraph
MEMGRAPH_SPECS=

# --- FalkorDB (Cloud free tier or resource-capped Docker) ---
FALKORDB_URI=
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_DATABASE=benchmark
FALKORDB_SPECS=

# --- ArangoDB (free trial or resource-capped Docker) ---
ARANGODB_URI=
ARANGODB_USERNAME=root
ARANGODB_PASSWORD=
ARANGODB_DATABASE=benchmark
ARANGODB_SPECS=

# --- Benchmark settings (identical for every platform) ---
BENCH_SEED=42
BENCH_WARMUP_ITERATIONS=20
BENCH_MEASURED_ITERATIONS=100
BENCH_CONCURRENCY_LEVELS=1,10,40
BENCH_READ_RATIO=0.9
BENCH_BATCH_SIZE=1000
BENCH_QUERY_TIMEOUT_S=30
BENCH_DATA_DIR=data
BENCH_RESULTS_DIR=results
