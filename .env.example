# Copy to .env and fill in your own credentials. .env is git-ignored.
# Never commit connection URIs or passwords.
#
# A platform is benchmarked only if its *_URI is set; the others are reported
# as "not configured" instead of silently skipped.

# --- CognoDB Cloud (subject of the benchmark) ---
COGNODB_URI=bolt+s://<instance-id>.databases.cognodb.com
COGNODB_USERNAME=cognodb
COGNODB_PASSWORD=
COGNODB_DATABASE=neo4j
COGNODB_SPECS=free c0, burstable 0.5 vCPU / 256 MB RAM / 1 GB disk

# The four comparators below are the docker-compose.yml services, each capped
# to the same 0.5 vCPU / 512 MB as the CognoDB free instance. Swap in a hosted
# URI instead if you have one, and update *_SPECS to that tier's real numbers.

# --- Neo4j (resource-capped Community in Docker, or AuraDB Free) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=benchmark-neo4j
NEO4J_DATABASE=neo4j
NEO4J_SPECS=self-hosted neo4j:5.26-community, capped 0.5 vCPU / 512 MB RAM (256 MB heap, 64 MB page cache), local disk

# --- Memgraph (resource-capped Docker, or Memgraph Cloud free tier) ---
MEMGRAPH_URI=bolt://localhost:7688
MEMGRAPH_USERNAME=
MEMGRAPH_PASSWORD=
MEMGRAPH_DATABASE=memgraph
MEMGRAPH_SPECS=self-hosted memgraph:3.12.0, capped 0.5 vCPU / 512 MB RAM (384 MB store limit), local disk

# --- FalkorDB (resource-capped Docker, or FalkorDB Cloud free tier) ---
FALKORDB_URI=redis://localhost:6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_DATABASE=benchmark
FALKORDB_SPECS=self-hosted falkordb:v4.20.3, capped 0.5 vCPU / 512 MB RAM (384 MB maxmemory), local disk

# --- ArangoDB (resource-capped Docker, or ArangoGraph free trial) ---
ARANGODB_URI=http://localhost:8529
ARANGODB_USERNAME=root
ARANGODB_PASSWORD=benchmark-arango
ARANGODB_DATABASE=benchmark
ARANGODB_SPECS=self-hosted arangodb:3.12.4, capped 0.5 vCPU / 512 MB RAM, local disk

# --- Container caps used by docker-compose.yml ---
BENCH_CPUS=0.5
BENCH_MEMORY=512m
NEO4J_LOCAL_PASSWORD=benchmark-neo4j
ARANGODB_LOCAL_PASSWORD=benchmark-arango

# --- Benchmark settings (identical for every platform) ---
BENCH_SEED=42
BENCH_WARMUP_ITERATIONS=20
BENCH_MEASURED_ITERATIONS=100
# 20 sits between the assignment's suggested 10 and 40 to locate where a tier
# starts refusing clients rather than only observing that it does.
BENCH_CONCURRENCY_LEVELS=1,10,20,40
BENCH_READ_RATIO=0.9
BENCH_BATCH_SIZE=1000
BENCH_QUERY_TIMEOUT_S=30
BENCH_DATA_DIR=data
BENCH_RESULTS_DIR=results
